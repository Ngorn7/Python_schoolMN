# Copy to .env and adjust if needed. docker-compose reads this automatically.
POSTGRES_DB=school_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Password123@

# Used only for local (non-docker) runs; inside docker-compose the web
# service overrides POSTGRES_HOST=db, POSTGRES_PORT=5432 automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
